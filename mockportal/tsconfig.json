{
  "compilerOptions": {
    "target": "es2022",
    "moduleResolution": "node",
    "strict": true,
    "jsx": "react",
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false,
    "typeRoots": ["./node_modules/@types", "./.cache/isucon14-portal/portal/types"],
    "baseUrl": ".",
    "paths": {
      "@portal/*": [".cache/isucon14-portal/portal/app/javascript/*"],
      "@proto/*": [".cache/isucon14-portal/portal/proto/isuxportal/*"]
    }
  },
  "include": ["src"]
}
